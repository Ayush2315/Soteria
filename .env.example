# ==============================================================================
# SOTERIA PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env before running: cp .env.example .env

# --- Application Core ---
ENV=development
DEBUG=True
APP_NAME=SOTERIA
API_V1_STR=/api/v1
SECRET_KEY=soteria_super_secret_production_key_change_in_production_32char_min

# --- CORS & Security ---
# Comma-separated list of allowed origins or JSON list
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]

# --- Database & Spatial Engine (PostgreSQL + PostGIS) ---
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=soteria_db
# Async driver URL for FastAPI (SQLAlchemy + asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/soteria_db
# Synchronous driver URL for Alembic / Admin utilities
DATABASE_URL_SYNC=postgresql://postgres:postgres@db:5432/soteria_db

# --- Google Gemini AI Multimodal Engine ---
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- Geospatial & Frontend Maps ---
# Obtain public Mapbox token from https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_public_token_here
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development

# --- Disaster Response Engine Parameters ---
SITREP_INTERVAL_MINUTES=30
TRIAGE_SCORE_THRESHOLD_CRITICAL=80
TRIAGE_SCORE_THRESHOLD_URGENT=60
TRIAGE_SCORE_THRESHOLD_MODERATE=40
DEFAULT_SEARCH_RADIUS_METERS=5000
